From: Kernel patch series <noreply@example.com>
Subject: [PATCH] dt-bindings: gpu: add MediaTek MT8188 Mali compatible

diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
--- a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
@@ -28,6 +28,9 @@
               - rockchip,rk3568-mali
           - const: arm,mali-bifrost # Mali Bifrost GPU model/revision is fully discoverable
       - items:
+          - const: mediatek,mt8188-mali
+          - const: arm,mali-valhall
+      - items:
           - enum:
               - mediatek,mt8195-mali
           - const: mediatek,mt8192-mali
@@ -230,6 +233,24 @@
       properties:
         compatible:
           contains:
+            const: mediatek,mt8188-mali
+    then:
+      properties:
+        power-domains:
+          minItems: 3
+          maxItems: 3
+        power-domain-names:
+          items:
+            - const: core0
+            - const: core1
+            - const: core2
+      required:
+        - power-domains
+        - power-domain-names
+  - if:
+      properties:
+        compatible:
+          contains:
             const: mediatek,mt8192-mali
     then:
       properties:
-- 
2.43.0
