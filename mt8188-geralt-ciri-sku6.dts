	regulator-ppvar-sys {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_sys";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xaf>;
	};

	regulator-ppvar-mipi-disp-avdd {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_mipi_disp_avdd";
		enable-active-high;
		gpio = <0x2a 0x03 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xb3>;
		vin-supply = <0xb2>;
		phandle = <0x96>;
	};

	regulator-ppvar-mipi-disp-avee {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_mipi_disp_avee";
		regulator-enable-ramp-delay = <0x2710>;
		enable-active-high;
		gpio = <0x2a 0x04 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0xb4>;
		vin-supply = <0xb2>;
		phandle = <0x97>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@50000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x50000000 0x00 0x800000>;
			no-map;
			phandle = <0x42>;
		};

		memory@55000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x55000000 0x00 0x1400000>;
		};

		memory@60000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x60000000 0x00 0xf00000>;
			no-map;
			phandle = <0x4a>;
		};

		memory@60f00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x60f00000 0x00 0x100000>;
			no-map;
			phandle = <0x46>;
		};

		memory@61000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x61000000 0x00 0x100000>;
			no-map;
			phandle = <0x49>;
		};
	};
