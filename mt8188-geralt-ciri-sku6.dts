			compatible = "mediatek,mt8188-disp-ethdr", "mediatek,mt8195-disp-ethdr";
			reg = <0x00 0x1c114000 0x00 0x1000 0x00 0x1c115000 0x00 0x1000 0x00 0x1c117000 0x00 0x1000 0x00 0x1c119000 0x00 0x1000 0x00 0x1c11a000 0x00 0x1000 0x00 0x1c11b000 0x00 0x1000 0x00 0x1c11c000 0x00 0x1000>;
			reg-names = "mixer", "vdo_fe0", "vdo_fe1", "gfx_fe0", "gfx_fe1", "vdo_be", "adl_ds";
			clocks = <0x3b 0x30 0x3b 0x2b 0x3b 0x2e 0x3b 0x2c 0x3b 0x2f 0x3b 0x2d 0x3b 0x3c 0x3b 0x31 0x3b 0x32 0x3b 0x33 0x3b 0x34 0x3b 0x35 0x2d 0x05>;
			clock-names = "mixer", "vdo_fe0", "vdo_fe1", "gfx_fe0", "gfx_fe1", "vdo_be", "adl_ds", "vdo_fe0_async", "vdo_fe1_async", "gfx_fe0_async", "gfx_fe1_async", "vdo_be_async", "ethdr_top";
			interrupts = <0x00 0x236 0x04 0x00>;
			iommus = <0x79 0x64 0x79 0x65>;
			power-domains = <0x44 0x11>;
			resets = <0x3b 0x31 0x3b 0x32 0x3b 0x33 0x3b 0x34 0x3b 0x35>;
			mediatek,gce-client-reg = <0x78 0x07 0x4000 0x1000 0x78 0x07 0x5000 0x1000 0x78 0x07 0x7000 0x1000 0x78 0x07 0x9000 0x1000 0x78 0x07 0xa000 0x1000 0x78 0x07 0xb000 0x1000 0x78 0x07 0xc000 0x1000>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0xaa>;
						phandle = <0xa5>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0xab>;
						phandle = <0xa6>;
					};
				};
			};
		};

		padding@1c11d000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c11d000 0x00 0x1000>;
			clocks = <0x3b 0x1f>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x07 0xd000 0x1000>;
		};

		padding@1c11e000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c11e000 0x00 0x1000>;
			clocks = <0x3b 0x20>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x07 0xe000 0x1000>;
		};

		padding@1c11f000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c11f000 0x00 0x1000>;
			clocks = <0x3b 0x21>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x07 0xf000 0x1000>;
		};

		padding@1c120000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c120000 0x00 0x1000>;
			clocks = <0x3b 0x22>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x08 0x00 0x1000>;
		};

		padding@1c121000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c121000 0x00 0x1000>;
			clocks = <0x3b 0x23>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x08 0x1000 0x1000>;
		};

		padding@1c122000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c122000 0x00 0x1000>;
			clocks = <0x3b 0x24>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x08 0x2000 0x1000>;
		};

		padding@1c123000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c123000 0x00 0x1000>;
			clocks = <0x3b 0x25>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x08 0x3000 0x1000>;
		};

		padding@1c124000 {
			compatible = "mediatek,mt8188-disp-padding";
			reg = <0x00 0x1c124000 0x00 0x1000>;
			clocks = <0x3b 0x26>;
			power-domains = <0x44 0x11>;
			mediatek,gce-client-reg = <0x78 0x08 0x4000 0x1000>;
		};

		edp-tx@1c500000 {
			compatible = "mediatek,mt8188-edp-tx";
			reg = <0x00 0x1c500000 0x00 0x8000>;
			interrupts = <0x00 0x2a4 0x04 0x00>;
			nvmem-cells = <0xac>;
			nvmem-cell-names = "dp_calibration_data";
			power-domains = <0x44 0x13>;
			max-linkrate-mhz = <0x1fa4>;
			status = "disabled";
		};

		dp-tx@1c600000 {
			compatible = "mediatek,mt8188-dp-tx";
			reg = <0x00 0x1c600000 0x00 0x8000>;
			interrupts = <0x00 0x1ca 0x04 0x00>;
			nvmem-cells = <0xac>;
			nvmem-cell-names = "dp_calibration_data";
			power-domains = <0x44 0x12>;
			max-linkrate-mhz = <0x1518>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0xad>;
			#sound-dai-cells = <0x00>;
			phandle = <0x1e>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xae>;
						phandle = <0xa9>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						data-lanes = <0x00 0x01 0x02 0x03>;
					};
				};
			};
		};
	};

	backlight-lcd0 {
		compatible = "pwm-backlight";
		brightness-levels = <0x00 0x3ff>;
		default-brightness-level = <0x240>;
		enable-gpios = <0x2a 0x01 0x00>;
		num-interpolated-steps = <0x3ff>;
		power-supply = <0xaf>;
		pwms = <0xb0 0x00 0x7a120>;
		phandle = <0x95>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	dmic-codec {
		compatible = "dmic-codec";
		num-channels = <0x02>;
		wakeup-delay-ms = <0x64>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x00>;
	};

	regulator-pp1800-ldo-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp1800_ldo_z1";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		vin-supply = <0x68>;
	};

	regulator-pp3300-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x68>;
		phandle = <0x58>;
	};

	regulator-pp3300-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_z1";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0xaf>;
		phandle = <0x68>;
	};

	regulator-pp3300-wlan {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_wlan";
		regulator-always-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-high;
		gpio = <0x2a 0x0c 0x00>;
		pinctrl-0 = <0xb1>;
		pinctrl-names = "default";
		vin-supply = <0x68>;
		phandle = <0xb5>;
	};

	regulator-pp3300-mipi-tchscr {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_mipi_tchscr";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		enable-active-high;
		gpio = <0x2a 0x90 0x00>;
		vin-supply = <0x68>;
		phandle = <0xb6>;
	};

	regulator-pp4200-s5 {
		compatible = "regulator-fixed";
		regulator-name = "pp4200_s5";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x401640>;
		regulator-max-microvolt = <0x401640>;
		vin-supply = <0xaf>;
	};

	regulator-pp5000-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_z1";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0xaf>;
