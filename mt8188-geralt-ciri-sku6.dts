				};
			};
		};

		cpu-little3-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x1f 0x03>;

			trips {

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x23>;
				};

				trip-alert1 {
					temperature = <0x17318>;
