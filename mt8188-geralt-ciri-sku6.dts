/dts-v1/;

/ {
	compatible = "google,ciri-sku6", "google,ciri", "mediatek,mt8188";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Google Ciri sku6 board (rev4)";

	aliases {
		dp-intf0 = "/soc/dp-intf@1c015000";
		dp-intf1 = "/soc/dp-intf@1c113000";
		dsc0 = "/soc/dsc@1c009000";
		ethdr0 = "/soc/ethdr@1c114000";
		gce0 = "/soc/mailbox@10320000";
		gce1 = "/soc/mailbox@10330000";
		merge0 = "/soc/merge0@1c014000";
		merge1 = "/soc/merge@1c10c000";
		merge2 = "/soc/merge@1c10d000";
		merge3 = "/soc/merge@1c10e000";
		merge4 = "/soc/merge@1c10f000";
		merge5 = "/soc/merge@1c110000";
		mutex0 = "/soc/mutex@1c016000";
		mutex1 = "/soc/mutex@1c101000";
		padding0 = "/soc/padding@1c11d000";
		padding1 = "/soc/padding@1c11e000";
		padding2 = "/soc/padding@1c11f000";
		padding3 = "/soc/padding@1c120000";
		padding4 = "/soc/padding@1c121000";
		padding5 = "/soc/padding@1c122000";
		padding6 = "/soc/padding@1c123000";
		padding7 = "/soc/padding@1c124000";
		vdo1-rdma0 = "/soc/rdma@1c104000";
		vdo1-rdma1 = "/soc/rdma@1c105000";
		vdo1-rdma2 = "/soc/rdma@1c106000";
		vdo1-rdma3 = "/soc/rdma@1c107000";
		vdo1-rdma4 = "/soc/rdma@1c108000";
		vdo1-rdma5 = "/soc/rdma@1c109000";
		vdo1-rdma6 = "/soc/rdma@1c10a000";
		vdo1-rdma7 = "/soc/rdma@1c10b000";
		dsi0 = "/soc/dsi@1c008000";
		i2c0 = "/soc/i2c@11280000";
		i2c1 = "/soc/i2c@11e00000";
		i2c2 = "/soc/i2c@11281000";
		i2c3 = "/soc/i2c@11282000";
		i2c4 = "/soc/i2c@11e01000";
		i2c5 = "/soc/i2c@11ec0000";
		i2c6 = "/soc/i2c@11ec1000";
		mmc0 = "/soc/mmc@11230000";
		serial0 = "/soc/serial@11001100";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x400>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0d>;
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x500>;
			enable-method = "psci";
			clock-frequency = <0x77359400>;
			capacity-dmips-mhz = <0x11a>;
			cpu-idle-states = <0x02 0x03>;
			i-cache-size = <0x8000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x80>;
			d-cache-size = <0x8000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x80>;
			next-level-cache = <0x04>;
			performance-domains = <0x05 0x00>;
			#cooling-cells = <0x02>;
			phandle = <0x0e>;
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x600>;
			enable-method = "psci";
			clock-frequency = <0x9af8da00>;
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x06 0x07>;
			i-cache-size = <0x10000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x10000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x08>;
			performance-domains = <0x05 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x0f>;
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			reg = <0x700>;
			enable-method = "psci";
			clock-frequency = <0x9af8da00>;
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x06 0x07>;
			i-cache-size = <0x10000>;
			i-cache-line-size = <0x40>;
			i-cache-sets = <0x100>;
			d-cache-size = <0x10000>;
			d-cache-line-size = <0x40>;
			d-cache-sets = <0x100>;
			next-level-cache = <0x08>;
			performance-domains = <0x05 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x09>;
				};

				core1 {
					cpu = <0x0a>;
				};

				core2 {
					cpu = <0x0b>;
				};

				core3 {
					cpu = <0x0c>;
				};

				core4 {
					cpu = <0x0d>;
				};

				core5 {
					cpu = <0x0e>;
				};

				core6 {
					cpu = <0x0f>;
				};

				core7 {
					cpu = <0x10>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x5f>;
				min-residency-us = <0x244>;
				phandle = <0x02>;
			};

			cpu-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x2d>;
				exit-latency-us = <0x8c>;
				min-residency-us = <0x2e4>;
				phandle = <0x06>;
			};

			cluster-off-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010010>;
				local-timer-stop;
				entry-latency-us = <0x37>;
				exit-latency-us = <0x9b>;
				min-residency-us = <0x348>;
				phandle = <0x03>;
			};

			cluster-off-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010010>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0xc8>;
				min-residency-us = <0x3e8>;
				phandle = <0x07>;
			};
		};

		l2-cache0 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-size = <0x20000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			next-level-cache = <0x11>;
			cache-unified;
			phandle = <0x04>;
		};

		l2-cache1 {
			compatible = "cache";
			cache-level = <0x02>;
			cache-size = <0x40000>;
			cache-line-size = <0x40>;
			cache-sets = <0x200>;
			next-level-cache = <0x11>;
			cache-unified;
			phandle = <0x08>;
		};

		l3-cache {
			compatible = "cache";
			cache-level = <0x03>;
			cache-size = <0x200000>;
			cache-line-size = <0x40>;
			cache-sets = <0x800>;
			cache-unified;
			phandle = <0x11>;
		};
	};

	oscillator-13m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0xc65d40>;
		clock-output-names = "clk13m";
		phandle = <0x40>;
	};

	oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "clk26m";
		phandle = <0x43>;
	};

	oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "clk32k";
	};

	opp-table-gpu {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x77>;

		opp-390000000 {
			opp-hz = <0x00 0x173eed80>;
			opp-microvolt = <0x8c618>;
			opp-supported-hw = <0xff>;
		};

		opp-431000000 {
			opp-hz = <0x00 0x19b089c0>;
			opp-microvolt = <0x8f6ec>;
			opp-supported-hw = <0xff>;
		};

		opp-473000000 {
			opp-hz = <0x00 0x1c316840>;
			opp-microvolt = <0x927c0>;
			opp-supported-hw = <0xff>;
		};

		opp-515000000 {
			opp-hz = <0x00 0x1eb246c0>;
			opp-microvolt = <0x95894>;
			opp-supported-hw = <0xff>;
		};

		opp-556000000 {
