		syscon@10006000 {
			compatible = "mediatek,mt8188-scpsys", "syscon", "simple-mfd";
			reg = <0x00 0x10006000 0x00 0x1000>;

			power-controller {
				compatible = "mediatek,mt8188-power-controller";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				#power-domain-cells = <0x01>;
				phandle = <0x44>;

				power-domain@0 {
					reg = <0x00>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;
					domain-supply = <0x2b>;

					power-domain@1 {
						reg = <0x01>;
						clocks = <0x2c 0x0e 0x2d 0x14>;
						clock-names = "mfg", "alt";
						mediatek,infracfg = <0x2e>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;
						domain-supply = <0x2f>;

						power-domain@2 {
							reg = <0x02>;
							#power-domain-cells = <0x00>;
						};

						power-domain@3 {
							reg = <0x03>;
							#power-domain-cells = <0x00>;
						};

						power-domain@4 {
							reg = <0x04>;
							#power-domain-cells = <0x00>;
						};
					};
				};

				power-domain@15 {
					reg = <0x0f>;
					clocks = <0x2d 0x04 0x2d 0x07 0x2d 0x08 0x2d 0x0a 0x2d 0x33 0x2d 0x34 0x2d 0x3d 0x2d 0xb9 0x2d 0xbe 0x30 0x0c 0x30 0x0d 0x30 0x0e 0x30 0x0f 0x30 0x10 0x30 0x11 0x30 0x12 0x30 0x13 0x30 0x14 0x30 0x15 0x30 0x16 0x30 0x17 0x30 0x1a 0x30 0x1b 0x30 0x1c 0x30 0x1d 0x30 0x1e 0x30 0x1f 0x30 0x20>;
					clock-names = "top", "cam", "ccu", "img", "venc", "vdec", "wpe", "cfgck", "cfgxo", "ss-sram-cmn", "ss-sram-v0l0", "ss-sram-v0l1", "ss-sram-ve0", "ss-sram-ve1", "ss-sram-ifa", "ss-sram-cam", "ss-sram-v1l5", "ss-sram-v1l6", "ss-sram-rdr", "ss-iommu", "ss-imgcam", "ss-emi", "ss-subcmn-rdr", "ss-rsi", "ss-cmn-l4", "ss-vdec1", "ss-wpe", "ss-cvdo-ve1";
					mediatek,infracfg = <0x2e>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#power-domain-cells = <0x01>;

					power-domain@16 {
						reg = <0x10>;
						clocks = <0x2d 0xbb 0x2d 0xc0 0x31 0x18 0x31 0x19 0x31 0x1a 0x31 0x1b 0x31 0x1c 0x31 0x1d 0x31 0x0f>;
						clock-names = "cfgck", "cfgxo", "ss-gals", "ss-cmn", "ss-emi", "ss-iommu", "ss-larb", "ss-rsi", "ss-bus";
						mediatek,infracfg = <0x2e>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						#power-domain-cells = <0x01>;

						power-domain@20 {
							reg = <0x14>;
							clocks = <0x2d 0xba 0x2d 0xbf 0x32 0x1c 0x32 0x1d 0x32 0x1e 0x32 0x1f>;
							clock-names = "cfgck", "cfgxo", "ss-vpp1-g5", "ss-vpp1-g6", "ss-vpp1-l5", "ss-vpp1-l6";
							mediatek,infracfg = <0x2e>;
							#power-domain-cells = <0x00>;
						};

						power-domain@22 {
							reg = <0x16>;
							clocks = <0x33 0x00>;
							clock-names = "ss-vdec1-soc-l1";
							mediatek,infracfg = <0x2e>;
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#power-domain-cells = <0x01>;

							power-domain@23 {
								reg = <0x17>;
								clocks = <0x34 0x00>;
								clock-names = "ss-vdec2-l1";
								mediatek,infracfg = <0x2e>;
								#power-domain-cells = <0x00>;
							};
						};

						power-domain@29 {
							reg = <0x1d>;
							clocks = <0x2d 0x07 0x2d 0x08 0x2d 0x09 0x2d 0xbd>;
							clock-names = "cam", "ccu", "bus", "cfgck";
							mediatek,infracfg = <0x2e>;
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#power-domain-cells = <0x01>;
							domain-supply = <0x35>;

							power-domain@30 {
								reg = <0x1e>;
								clocks = <0x36 0x00 0x36 0x01 0x36 0x16 0x36 0x17 0x36 0x18>;
								clock-names = "ss-cam-l13", "ss-cam-l14", "ss-cam-mm0", "ss-cam-mm1", "ss-camsys";
								mediatek,infracfg = <0x2e>;
								#address-cells = <0x01>;
								#size-cells = <0x00>;
								#power-domain-cells = <0x01>;

								power-domain@32 {
									reg = <0x20>;
									clocks = <0x36 0x04 0x37 0x00 0x38 0x00>;
									clock-names = "ss-camb-sub", "ss-camb-raw", "ss-camb-yuv";
									#power-domain-cells = <0x00>;
								};

								power-domain@31 {
									reg = <0x1f>;
									clocks = <0x36 0x03 0x39 0x00 0x3a 0x00>;
									clock-names = "ss-cama-sub", "ss-cama-raw", "ss-cama-yuv";
									#power-domain-cells = <0x00>;
								};
							};
						};

						power-domain@17 {
							reg = <0x11>;
							clocks = <0x2d 0xbc 0x2d 0xc1 0x3b 0x00 0x3b 0x01 0x3b 0x02>;
							clock-names = "cfgck", "cfgxo", "ss-larb2", "ss-larb3", "ss-gals";
							mediatek,infracfg = <0x2e>;
							#address-cells = <0x01>;
							#size-cells = <0x00>;
							#power-domain-cells = <0x01>;

							power-domain@9 {
								reg = <0x09>;
								clocks = <0x2d 0x40 0x2d 0x3f>;
								clock-names = "bus", "hdcp";
								mediatek,infracfg = <0x2e>;
								#power-domain-cells = <0x00>;
							};

							power-domain@18 {
								reg = <0x12>;
								mediatek,infracfg = <0x2e>;
								#power-domain-cells = <0x00>;
							};

							power-domain@19 {
								reg = <0x13>;
								mediatek,infracfg = <0x2e>;
								#power-domain-cells = <0x00>;
							};
						};

						power-domain@24 {
							reg = <0x18>;
							clocks = <0x3c 0x00 0x3c 0x01 0x3c 0x05 0x3c 0x06>;
							clock-names = "ss-ve1-larb", "ss-ve1-core", "ss-ve1-gals", "ss-ve1-sram";
							mediatek,infracfg = <0x2e>;
							#power-domain-cells = <0x00>;
						};

						power-domain@21 {
							reg = <0x15>;
							clocks = <0x3d 0x01 0x3d 0x03>;
							clock-names = "ss-wpe-l7", "ss-wpe-l7pce";
							mediatek,infracfg = <0x2e>;
							#power-domain-cells = <0x00>;
						};
					};
				};

				power-domain@5 {
					reg = <0x05>;
					mediatek,infracfg = <0x2e>;
					clocks = <0x3e 0x0c>;
					clock-names = "ss-pextp-fmem";
					#power-domain-cells = <0x00>;
