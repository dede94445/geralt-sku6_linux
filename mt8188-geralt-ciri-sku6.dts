		};

		opp-835000000 {
			opp-hz = <0x00 0x31c516c0>;
			opp-microvolt = <0xb2872>;
			opp-supported-hw = <0xff>;
		};

		opp-880000000 {
			opp-hz = <0x00 0x3473bc00>;
			opp-microvolt = <0xb71b0>;
			opp-supported-hw = <0xff>;
		};

		opp-915000000 {
			opp-hz = <0x00 0x3689cac0>;
			opp-microvolt = <0xbd358>;
			opp-supported-hw = <0x8f>;
		};

		opp-915000000-5 {
			opp-hz = <0x00 0x3689cac0>;
