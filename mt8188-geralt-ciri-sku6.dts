							mediatek,infracfg = <0x2e>;
							#power-domain-cells = <0x00>;
						};

						power-domain@13 {
							reg = <0x0d>;
							clocks = <0x2d 0x53 0x2d 0x1f 0x3f 0x00>;
							clock-names = "a1sys", "intbus", "adspck";
