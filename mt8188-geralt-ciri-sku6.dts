	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x12>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a78-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x13>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	sound {
		mediatek,platform = <0x14>;
		status = "okay";
		pinctrl-names = "aud_etdm_hp_on", "aud_etdm_hp_off", "aud_etdm_spk_on", "aud_etdm_spk_off", "aud_mtkaif_on", "aud_mtkaif_off";
		pinctrl-0 = <0x15>;
		pinctrl-1 = <0x16>;
		pinctrl-2 = <0x17>;
		pinctrl-3 = <0x18>;
		pinctrl-4 = <0x19>;
		pinctrl-5 = <0x1a>;
		mediatek,adsp = <0x1b>;
		compatible = "mediatek,mt8188-es8326";
		model = "mt8188_tas2563_8326";
		audio-routing = "ETDM1_OUT", "ETDM_SPK_PIN", "ETDM2_OUT", "ETDM_HP_PIN", "ETDM1_IN", "ETDM_SPK_PIN", "ETDM2_IN", "ETDM_HP_PIN", "ADDA Capture", "MTKAIF_PIN", "Headphone Jack", "HPOL", "Headphone Jack", "HPOR", "MIC1", "Headset Mic";

		dai-link-0 {
			link-name = "ETDM2_OUT_BE";
			mediatek,clk-provider = "cpu";

			codec {
				sound-dai = <0x1d>;
			};
		};

		dai-link-1 {
			link-name = "ETDM2_IN_BE";
			mediatek,clk-provider = "cpu";

			codec {
				sound-dai = <0x1d>;
			};
		};

		dai-link-2 {
			link-name = "ETDM1_OUT_BE";
			dai-format = "i2s";
			mediatek,clk-provider = "cpu";

			codec {
				sound-dai = <0x1c>;
			};
		};

		dai-link-3 {
			link-name = "ETDM1_IN_BE";
			dai-format = "i2s";
			mediatek,clk-provider = "cpu";
		};

		dai-link-4 {
			link-name = "DPTX_BE";

			codec {
				sound-dai = <0x1e>;
			};
		};
	};

	thermal-zones {

		cpu-little0-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x1f 0x00>;

			trips {

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x20>;
				};

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x20>;
					cooling-device = <0x09 0xffffffff 0xffffffff 0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu-little1-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x1f 0x01>;

			trips {

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x21>;
				};

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x21>;
					cooling-device = <0x09 0xffffffff 0xffffffff 0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu-little2-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x1f 0x02>;

			trips {

				trip-alert0 {
