		};

		opp-730000000 {
			opp-hz = <0x00 0x2b82ea80>;
			opp-microvolt = <0xa7d8c>;
			opp-supported-hw = <0xff>;
		};

		opp-760000000 {
			opp-hz = <0x00 0x2d4cae00>;
			opp-microvolt = <0xaae60>;
			opp-supported-hw = <0xff>;
		};

		opp-790000000 {
			opp-hz = <0x00 0x2f167180>;
