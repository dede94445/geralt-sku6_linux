/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "Google Ciri sku6(rev4) board";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "google,ciri-sku6", "google,ciri", "mediatek,mt8188";

	lpddr-channel3 {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		io-width = <0x10>;
		compatible = "jedec,lpddr4-channel";

		rank@1 {
			io-width = <0x10>;
			density = <0x2000>;
			revision-id = <0x08 0x00>;
			compatible = "lpddr4-01,0800", "jedec,lpddr4";
			reg = <0x01>;
		};

		rank@0 {
			io-width = <0x10>;
			density = <0x2000>;
			revision-id = <0x08 0x00>;
			compatible = "lpddr4-01,0800", "jedec,lpddr4";
			reg = <0x00>;
		};
	};

	lpddr-channel1 {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		io-width = <0x10>;
		compatible = "jedec,lpddr4-channel";

		rank@1 {
			io-width = <0x10>;
			density = <0x2000>;
			revision-id = <0x08 0x00>;
			compatible = "lpddr4-01,0800", "jedec,lpddr4";
			reg = <0x01>;
		};

		rank@0 {
			io-width = <0x10>;
			density = <0x2000>;
			revision-id = <0x08 0x00>;
			compatible = "lpddr4-01,0800", "jedec,lpddr4";
			reg = <0x00>;
		};
	};

	opp-table-ipe {
		compatible = "operating-points-v2";
		phandle = <0xa8>;

		opp-546000000 {
			opp-microvolt = <0xb1008>;
			opp-hz = <0x00 0x208b4c80>;
		};

		opp-458000000 {
			opp-microvolt = <0x9eb10>;
			opp-hz = <0x00 0x1b4c8680>;
		};

		opp-364000000 {
			opp-microvolt = <0x927c0>;
			opp-hz = <0x00 0x15b23300>;
		};

		opp-273000000 {
			opp-microvolt = <0x86470>;
			opp-hz = <0x00 0x1045a640>;
		};
	};

	backlight-lcd {
		power-supply = <0xd2>;
		num-interpolated-steps = <0x3ff>;
		default-brightness-level = <0x240>;
		compatible = "pwm-backlight";
		enable-gpios = <0x23 0x01 0x00>;
		brightness-levels = <0x00 0x3ff>;
		phandle = <0xc1>;
		pwms = <0xd3 0x00 0x7a120>;
	};

	regulator-pp5000-usb-p1-vbus {
		gpio = <0x23 0x96 0x00>;
		enable-active-high;
		regulator-name = "pp5000_usb_p1_vbus";
		compatible = "regulator-fixed";
		phandle = <0x64>;
		vin-supply = <0xd0>;
	};

	thermal-zones {

		cpu-little0-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x21 0x00>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		adsp-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x22 0x03>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		vdo-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x22 0x04>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		cpu-little2-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x96>;
			thermal-sensors = <0x21 0x02>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		cpu-big1-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x21 0x05>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
