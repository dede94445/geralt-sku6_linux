				};

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		cam2-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x22 0x07>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
