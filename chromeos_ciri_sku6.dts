				trip-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		gpu1-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x22 0x02>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		soc_max {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x1f 0x00>;
			sustainable-power = <0x5dc>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-switch-on {
					temperature = <0x109a0>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				trip-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
				};

				trip-alert0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x20>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x20>;
					cooling-device = <0x09 0xffffffff 0xffffffff 0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff>;
					contribution = <0x929>;
				};

				map1 {
					trip = <0x20>;
					cooling-device = <0x0f 0xffffffff 0xffffffff 0x10 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};
	};

	soc {
		dma-ranges = <0x00 0x00 0x00 0x00 0x04 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges;

		merge@1c10e000 {
			power-domains = <0x4b 0x11>;
			clock-names = "merge", "merge_async";
			resets = <0x36 0x1a>;
			interrupts = <0x00 0x1f9 0x04 0x00>;
			clocks = <0x36 0x0b 0x36 0x1a>;
			mediatek,merge-mute = <0x01>;
			compatible = "mediatek,mt8188-disp-merge", "mediatek,mt8195-disp-merge";
			mediatek,gce-client-reg = <0x45 0x06 0xe000 0x1000>;
			reg = <0x00 0x1c10e000 0x00 0x1000>;
		};

		t-phy@11e80000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "mediatek,mt8188-tphy", "mediatek,generic-tphy-v3";
			ranges = <0x00 0x00 0x11e80000 0x1000>;
			status = "okay";

			usb-phy@0 {
				clock-names = "ref", "da_ref";
				clocks = <0x26 0xcc 0x25 0x0f>;
				#phy-cells = <0x01>;
				status = "okay";
				reg = <0x00 0x700>;
				phandle = <0x76>;
			};
		};

		smi@14013000 {
			power-domains = <0x4b 0x0f>;
			clock-names = "apb", "smi";
			clocks = <0x29 0x1d 0x29 0x1d>;
			mediatek,larb-id = <0x04>;
			compatible = "mediatek,mt8188-smi-larb";
			reg = <0x00 0x14013000 0x00 0x1000>;
			phandle = <0x99>;
			mediatek,smi = <0x96>;
		};

		clock-controller@17200000 {
			#clock-cells = <0x01>;
			compatible = "mediatek,mt8188-ccusys";
			reg = <0x00 0x17200000 0x00 0x1000>;
			phandle = <0xb4>;
		};

		padding@1c11e000 {
			power-domains = <0x4b 0x11>;
			clocks = <0x36 0x20>;
			compatible = "mediatek,mt8188-disp-padding";
			mediatek,gce-client-reg = <0x45 0x07 0xe000 0x1000>;
			reg = <0x00 0x1c11e000 0x00 0x1000>;
		};

		thermal-sensor@11278000 {
			nvmem-cells = <0x57>;
			resets = <0x27 0x00>;
			interrupts = <0x00 0xca 0x04 0x00>;
			clocks = <0x27 0x08>;
			#thermal-sensor-cells = <0x01>;
			compatible = "mediatek,mt8188-lvts-mcu";
			nvmem-cell-names = "lvts-calib-data-1";
			reg = <0x00 0x11278000 0x00 0x1000>;
			phandle = <0x21>;
		};

		mtk-apu-mem-code {
			iommus = <0xb6 0x00>;
			mask = <0x03 0xffffffff>;
			type = <0x01>;
			compatible = "mediatek,apu-mem-code";
			status = "okay";
		};

		smi@15530000 {
			power-domains = <0x4b 0x1b>;
			mediatek,smi-sub-comm-inport = <0x02>;
			mediatek,smi-sub-comm = <0x40>;
			clock-names = "apb", "smi";
			clocks = <0x39 0x07 0x3c 0x00>;
			mediatek,larb-id = <0x0b>;
			compatible = "mediatek,mt8188-smi-larb";
			mediatek,smi-reset = <0x3c 0x04>;
			reg = <0x00 0x15530000 0x00 0x1000>;
			phandle = <0x9c>;
			mediatek,smi = <0x96>;
		};

		clock-controller@14e02000 {
			#clock-cells = <0x01>;
			compatible = "mediatek,mt8188-wpesys-vpp0";
			reg = <0x00 0x14e02000 0x00 0x1000>;
		};

		clock-controller@16000000 {
			#clock-cells = <0x01>;
			compatible = "mediatek,mt8188-camsys";
			reg = <0x00 0x16000000 0x00 0x1000>;
			phandle = <0x2f>;
		};

		mutex@1c101000 {
			power-domains = <0x4b 0x11>;
			clock-names = "vdo1_mutex";
			reg-names = "vdo1_mutex";
			interrupts = <0x00 0x1ee 0x04 0x00>;
			clocks = <0x36 0x10>;
			compatible = "mediatek,mt8188-disp-mutex";
			mediatek,gce-events = <0x2c5>;
			reg = <0x00 0x1c101000 0x00 0x1000>;
		};

		usb@112b0000 {
			clock-names = "sys_ck", "ref_ck", "mcu_ck";
			reg-names = "mac", "ippc";
			assigned-clocks = <0x26 0x2c 0x26 0x2b>;
			assigned-clock-parents = <0x26 0x76 0x26 0x76>;
			wakeup-source;
			interrupts = <0x00 0x215 0x04 0x00>;
			clocks = <0x42 0x05 0x26 0xc9 0x42 0x06>;
			compatible = "mediatek,mt8188-xhci", "mediatek,mtk-xhci";
			status = "okay";
			phys = <0x77 0x03>;
			reg = <0x00 0x112b0000 0x00 0x1000 0x00 0x112b3e00 0x00 0x100>;
			mediatek,syscon-wakeup = <0x63 0x460 0x02>;
		};

		syscon@16006000 {
			power-domains = <0x4b 0x1f>;
			clock-names = "apb", "smi";
			clocks = <0x2f 0x03 0x33 0x00>;
			compatible = "mediatek,mt8188-smi-cam1", "mediatek,mt8188-smi-sub-common", "syscon";
			mediatek,common-id = <0x06>;
			reg = <0x00 0x16006000 0x00 0x1000>;
			phandle = <0x35>;
			mediatek,smi = <0x96>;
		};

		apusys-hw-logger@0x19024000 {
			power-domains = <0xb9 0x00>;
			iommus = <0xbb 0x20>;
			interrupts = <0x00 0x1a8 0x04 0x00>;
			compatible = "mediatek,apusys-hw-logger";
			status = "okay";
			reg = <0x00 0x19024000 0x00 0x1000>;
			phandle = <0xba>;
		};

		jpeg-encoder@1a030000 {
			power-domains = <0x4b 0x18>;
			iommus = <0xae 0x2a7 0xae 0x2a8 0xae 0x2a9 0xae 0x2ac>;
			mediatek,larb = <0x15>;
			clock-names = "jpgenc";
			interrupts = <0x00 0x162 0x04 0x00>;
			clocks = <0x37 0x02>;
			mediatek,34bits = <0x01>;
			compatible = "mediatek,mt8188-jpgenc", "mediatek,mtk-jpgenc";
			reg = <0x00 0x1a030000 0x00 0x10000>;
		};

		clock-controller@15330000 {
			#clock-cells = <0x01>;
			compatible = "mediatek,mt8188-ipesys";
			reg = <0x00 0x15330000 0x00 0x1000>;
			phandle = <0x41>;
		};

		imgsys-l10 {
			iommus = <0xae 0x120 0xae 0x121 0xae 0x122 0xae 0x123 0xae 0x124 0xae 0x125 0xae 0x126 0xae 0x127 0xae 0x128 0xae 0x129 0xae 0x12a 0xae 0x12b 0xae 0x12c 0xae 0x12d 0xae 0x12e 0xae 0x12f 0xae 0x130 0xae 0x131 0xae 0x132 0xae 0x133>;
			dma-ranges = <0x02 0x00 0x00 0x40000000 0x01 0x00>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			compatible = "mediatek,imgsys-larb";
		};

		clock-controller@13fbf000 {
			#clock-cells = <0x01>;
			compatible = "mediatek,mt8188-mfgcfg";
			reg = <0x00 0x13fbf000 0x00 0x1000>;
			phandle = <0x93>;
		};

		usb@11200000 {
			clock-names = "sys_ck", "ref_ck", "mcu_ck";
			reg-names = "mac", "ippc";
			assigned-clocks = <0x26 0x29 0x26 0x2a>;
			assigned-clock-parents = <0x26 0x76 0x26 0x76>;
			wakeup-source;
			interrupts = <0x00 0x81 0x04 0x00>;
			clocks = <0x42 0x09 0x26 0xc5 0x42 0x0a>;
			vbus-supply = <0x64>;
			compatible = "mediatek,mt8188-xhci", "mediatek,mtk-xhci";
			status = "okay";
			phys = <0x61 0x03 0x62 0x04>;
			reg = <0x00 0x11200000 0x00 0x1000 0x00 0x11203e00 0x00 0x100>;
			mediatek,syscon-wakeup = <0x63 0x468 0x02>;
		};

		padding@1c123000 {
			power-domains = <0x4b 0x11>;
			clocks = <0x36 0x25>;
			compatible = "mediatek,mt8188-disp-padding";
			mediatek,gce-client-reg = <0x45 0x08 0x3000 0x1000>;
			reg = <0x00 0x1c123000 0x00 0x1000>;
		};

		merge@1c110000 {
			power-domains = <0x4b 0x11>;
			mediatek,merge-fifo-en = <0x01>;
			clock-names = "merge", "merge_async";
			resets = <0x36 0x1c>;
