			cpu-idle-states = <0x03 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			d-cache-size = <0x8000>;
			next-level-cache = <0x05>;
			i-cache-size = <0x8000>;
			reg = <0x00>;
			enable-method = "psci";
			phandle = <0x09>;
			d-cache-sets = <0x80>;
			i-cache-sets = <0x80>;
			#cooling-cells = <0x02>;
		};

		cpu@100 {
			d-cache-line-size = <0x40>;
			performance-domains = <0x02 0x00>;
			capacity-dmips-mhz = <0x11a>;
			i-cache-line-size = <0x40>;
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x03 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			d-cache-size = <0x8000>;
			next-level-cache = <0x05>;
			i-cache-size = <0x8000>;
			reg = <0x100>;
			enable-method = "psci";
			phandle = <0x0a>;
			d-cache-sets = <0x80>;
			i-cache-sets = <0x80>;
			#cooling-cells = <0x02>;
		};

		cpu@400 {
			d-cache-line-size = <0x40>;
			performance-domains = <0x02 0x00>;
			capacity-dmips-mhz = <0x11a>;
			i-cache-line-size = <0x40>;
			clock-frequency = <0x77359400>;
			cpu-idle-states = <0x03 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			d-cache-size = <0x8000>;
			next-level-cache = <0x05>;
			i-cache-size = <0x8000>;
			reg = <0x400>;
			enable-method = "psci";
			phandle = <0x0d>;
			d-cache-sets = <0x80>;
			i-cache-sets = <0x80>;
			#cooling-cells = <0x02>;
		};

		cpu@700 {
			d-cache-line-size = <0x40>;
			performance-domains = <0x02 0x01>;
			capacity-dmips-mhz = <0x400>;
			i-cache-line-size = <0x40>;
			clock-frequency = <0x9af8da00>;
			cpu-idle-states = <0x06 0x07>;
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			d-cache-size = <0x10000>;
			next-level-cache = <0x08>;
			i-cache-size = <0x10000>;
			reg = <0x700>;
			enable-method = "psci";
			phandle = <0x10>;
			d-cache-sets = <0x100>;
			i-cache-sets = <0x100>;
			#cooling-cells = <0x02>;
		};
	};

	pmu-a78 {
		interrupts = <0x01 0x07 0x04 0x13>;
		interrupt-parent = <0x01>;
		compatible = "arm,cortex-a78-pmu";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		scp-isp-cma-region {
			compatible = "shared-dma-pool";
			reg = <0x00 0x7a000000 0x00 0x5000000>;
			phandle = <0x49>;
			reusable;
		};

		scp-mem-region {
			compatible = "shared-dma-pool";
			reg = <0x00 0x50000000 0x00 0x900000>;
			phandle = <0x46>;
			no-map;
		};

		adsp-mem-region {
			compatible = "mediatek,adsp-reserved-memory";
			reg = <0x00 0x60000000 0x00 0xf00000>;
			phandle = <0x51>;
			no-map;
		};

		adsp-dma-mem-region {
			compatible = "shared-dma-pool";
			reg = <0x00 0x61000000 0x00 0x100000>;
			phandle = <0x50>;
			no-map;
		};

		secure-region {
			compatible = "mediatek,dynamic-restricted-region";
			reg = <0x00 0x7f000000 0x00 0x400000>;
			phandle = <0xd4>;
			no-map;
		};

		scp-dual-mem-region {
			compatible = "shared-dma-pool";
			reg = <0x00 0x70000000 0x00 0xa000000>;
			phandle = <0x48>;
			no-map;
		};

		ramoops {
			dump-oops;
			record-size = <0x40000>;
			pmsg-size = <0x20000>;
			compatible = "ramoops";
			console-size = <0x40000>;
			reg = <0x00 0xffec4000 0x00 0x100000>;
			ftrace-size = <0x20000>;
		};

		apu-reserve-memory {
			compatible = "shared-dma-pool";
			reg = <0x00 0x55000000 0x00 0x1400000>;
			phandle = <0xb8>;
		};

		snd-dma-mem-region {
			compatible = "shared-dma-pool";
			reg = <0x00 0x60f00000 0x00 0x100000>;
			phandle = <0x4d>;
			no-map;
		};
	};

	regulator-pp1800-ldo-z1 {
		regulator-max-microvolt = <0x1b7740>;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-name = "pp1800_ldo_z1";
		compatible = "regulator-fixed";
		vin-supply = <0xd5>;
	};

	oscillator-13m {
		clock-output-names = "clk13m";
		#clock-cells = <0x00>;
		clock-frequency = <0xc65d40>;
		compatible = "fixed-clock";
		phandle = <0x44>;
	};

	regulator-ppvar-mipi-disp-avdd {
		pinctrl-names = "default";
		gpio = <0x23 0x03 0x00>;
		pinctrl-0 = <0xcf>;
		enable-active-high;
		regulator-name = "ppvar_mipi_disp_avdd";
		compatible = "regulator-fixed";
		phandle = <0xbf>;
		vin-supply = <0xd0>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x14600000 0x00 0x54700000 0x00 0xab700000 0x01 0x00 0x01 0x40000000>;
	};
};
