				};

				trip-alert0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
				};
			};
		};

		gpu-thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x22 0x01>;

			trips {

				trip-alert1 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "hot";
				};

				trip-crit {
					temperature = <0x186a0>;
					hysteresis = <0x00>;
